@startuml Backend_Models_Class_Diagram
!theme aws-orange
title Data Research Analysis Platform - Backend Models (2026)

' Define styling
skinparam class {
    BackgroundColor LightBlue
    BorderColor DarkBlue
    ArrowColor DarkBlue
}
skinparam package {
    BackgroundColor LightGray
    BorderColor Gray
}

' ------------------------------------------------------------------
' Auth / users
package "Auth & Users" {
    class DRAUsersPlatform {
        +id: number
        +email: string
        +first_name / last_name: string
        +password: string
        +user_type: EUserType (admin|normal)
        +email_verified_at: Date
        +unsubscribe_from_emails_at: Date
        +interested_subscription_tier_id: number
        +interested_billing_cycle: monthly|annual
        --
        +projects, data_sources, data_models: [...]
        +verification_codes, dashboards: [...]
        +articles, categories: [...]
    }

    class DRAVerificationCode {
        +id: number
        +code: string
        +expired_at: Date
        --
        +users_platform: DRAUsersPlatform
    }

    class DRAEmailPreferences {
        +id: number
        +opt_in flags (subscription, expiry, renewal, promo)
        --
        +user: DRAUsersPlatform  (unique)
    }
}

' ------------------------------------------------------------------
' Tenancy
package "Tenancy (Org > Workspace > Project)" {
    class DRAOrganization {
        +id: number
        +name: string
        +domain: string
        +sso_enabled: boolean
        +settings: JSONB
        +branding colors / logo
        --
        +workspaces: DRAWorkspace[]
        +members: DRAOrganizationMember[]
        +subscription: DRAOrganizationSubscription
        +projects: DRAProject[]
    }

    class DRAWorkspace {
        +id: number
        +name: string
        +slug: string  (unique per org)
        +organization_id: number
        --
        +members: DRAWorkspaceMember[]
        +projects: DRAProject[]
    }

    class DRAOrganizationMember {
        +organization_id: number
        +users_platform_id: number
        +role: owner|admin|member
        --
        +user: DRAUsersPlatform
    }

    class DRAWorkspaceMember {
        +workspace_id: number
        +users_platform_id: number
        +role: admin|editor|viewer
        --
        +user: DRAUsersPlatform
    }

    class DRAProjectMember {
        +project_id: number
        +users_platform_id: number
        +marketing_role: analyst|manager|cmo
        --
        +project: DRAProject
    }

    class DRAProject {
        +id: number
        +name: string
        +organization_id: number
        +workspace_id: number
        +current_plan_id: number
        --
        +data_sources: DRADataSource[]
        +dashboards: DRADashboard[]
        +campaigns: DRACampaign[]
    }

    class DRAOrganizationInvitation {
        +id: number
        +organization_id: number
        +token: string (128-char hex)
        +role: string
        +expires_at: Date
        +status: pending|accepted|expired|cancelled
    }

    class DRASSOConfiguration {
        +organization_id: number (unique)
        +entity_id / sso_url / cert
        +allow_jit_provisioning / enforce_sso
        --
        +mappings: DRASSOUserMapping[]
    }
}

' ------------------------------------------------------------------
' Data sources & models
package "Data Layer" {
    class DRADataSource {
        +id: number
        +name: string
        +data_type: EDataSourceType (14 types)
        +connection_details: JSONB  {encrypted AES-256-GCM}
        +connection_string: string  {encrypted - MongoDB}
        +sync_schedule / sync_status / last_sync_at
        +classification: string
        +organization_id / workspace_id / project_id
        --
        +data_models: DRADataModel[]
        +table_metadata: DRATableMetadata[]
    }

    class DRADataModel {
        +id: number
        +schema: string  (physical schema, usually public)
        +name: string  (physical table name)
        +sql_query: string
        +query: JSONB  (visual query structure)
        +data_layer: raw_data|clean_data|business_ready
        +layer_config: JSONB
        +health_status / health_issues
        +refresh_status / last_refreshed_at
        +is_cross_source: boolean
        --
        +data_source: DRADataSource (nullable)
        +refresh_history: DRADataModelRefreshHistory[]
        +parent_lineages / child_lineages: DRADataModelLineage[]
    }

    class DRADataModelLineage {
        +child_data_model_id: number
        +parent_data_model_id: number
        +parent_data_model_name: string
        +parent_last_refreshed_at: Date
    }

    class DRADataModelRefreshHistory {
        +data_model_id: number
        +status: QUEUED|RUNNING|COMPLETED|FAILED
        +triggered_by: user|cascade|schedule|api
        +rows_before / rows_after / rows_changed
        +duration_ms / error_message / query_executed
    }

    class DRATableMetadata {
        +schema_name: string
        +physical_table_name: string
        +logical_table_name: string
        +original_sheet_name: string
        +file_id: string
        +table_type: string
    }

    class DRAMongoDBSyncHistory {
        +data_source_id: number
        +collection_name / table_name
        +sync_type: full|incremental
        +status: in_progress|completed|failed
        +records_synced / records_failed
    }
}

' ------------------------------------------------------------------
' Dashboards / reports
package "Dashboard & Visualization" {
    class DRADashboard {
        +id: number
        +name: string
        +data: JSONB  (widget configs)
        +is_template: boolean
        +source_template_id: number
        +organization_id / workspace_id / project_id
        --
        +export_metadata: DRADashboardExportMetaData[]
    }

    class DRADashboardExportMetaData {
        +dashboard_id: number
        +file_name / file_path / file_size
        +share_key: string
        +expires_at: Date
    }

    class DRAReport {
        +id: number
        +project_id: number
        +title: string
        +status: draft|published
        +plan_id / artifact_key
        --
        +items: DRAReportItem[]
        +share_key: DRAReportShareKey
    }

    class DRAReportItem {
        +report_id: number
        +sort_order: number
        +type: dashboard|widget|insight|kpi_card|data_table|text_block
        +payload: JSONB
    }

    class DRAReportShareKey {
        +report_id: number (unique)
        +share_key: string (UUID)
        +expires_at: Date
    }
}

' ------------------------------------------------------------------
' AI
package "AI" {
    class DRAAIDataModelConversation {
        +id: number
        +data_source_id: number
        +data_model_id: number (nullable)
        +status: draft|saved|archived
        --
        +messages: DRAAIDataModelMessage[]
    }

    class DRAAIDataModelMessage {
        +conversation_id: number
        +role: user|assistant|system
        +content: string
        +metadata: JSONB
    }

    class DRAAIInsightReport {
        +id: number
        +project_id: number
        +data_source_ids: JSONB
        +insights_summary: JSONB
        +status: draft|saved|archived
    }

    class DRAAICallLog {
        +id: number
        +feature_key: string (17 AI features)
        +action_id: string
        +model_id: string
        +input/output/cached/thought tokens
        +cost_usd: decimal
        +latency_ms: number
        +status: success|failed|fallback|skipped_no_data
        +organization_id / project_id / user_id
    }
}

' ------------------------------------------------------------------
' Plans / campaigns
package "Paid Media Plans & Campaigns" {
    class DRAPaidMediaPlan {
        +id: number
        +project_id / organization_id / workspace_id (nullable)
        +is_guest: boolean
        +guest_token: string
        +mode: basic|advanced
        +status: draft|running|paused|completed|failed|archived
        +current_step: number
        +state: JSONB
        +budget_total / platforms / markets
        --
        +steps: DRAPaidMediaPlanStep[]
        +artifacts: DRAPaidMediaPlanArtifact[]
        +messages: DRAPaidMediaPlanMessage[]
    }

    class DRAPaidMediaPlanStep {
        +plan_id: number
        +step_number: number
        +step_key: string
        +status: pending|running|waiting_for_input|completed|failed|skipped
        +gate: JSONB
        +run_meta: JSONB
    }

    class DRAPaidMediaPlanArtifact {
        +plan_id: number
        +kind: markdown|json|csv|xlsx|pptx|html|image
        +key / path / title
        +is_current: boolean
        +storage_key: string (binaries)
    }

    class DRACampaign {
        +id: number
        +project_id / organization_id / workspace_id
        +objective: string
        +status: string
        +budget_total / target_* metrics
        +plan_id: number (nullable)
        +external_campaign_id: string
        +linked_data_source_id: number
        --
        +channels: DRACampaignChannel[]
    }

    class DRACampaignChannel {
        +campaign_id: number
        +platform: string
        +online/offline flags
        +platform_campaign_mapping
        --
        +offline_data: DRACampaignOfflineData[]
    }
}

' ------------------------------------------------------------------
' Billing
package "Billing & Subscription" {
    class DRASubscriptionTier {
        +id: number
        +tier_name: string (unique)
        +tier_rank: 0|10|20|30|40
        +max_projects / max_data_sources_per_project / max_dashboards
        +max_rows_per_data_model / max_data_models_per_data_source
        +max_members_per_project
        +ai_generations_per_month / max_plans_per_month
        +ai_cost_ceiling_usd
        +price_per_month_usd / price_per_year_usd
        +paddle_price_id_monthly / annual
        +plan_advanced_mode_allowed / plan_ai_chat_allowed
        +plan_deck_export_allowed / advanced_tools_allowed
        +grace_period_days
    }

    class DRAOrganizationSubscription {
        +organization_id: number (unique, 1:1)
        +subscription_tier_id: number
        +paddle_subscription_id / paddle_customer_id
        +billing_cycle: monthly|annual
        +grace_period_ends_at / last_payment_failed_at
        +max_members / current_members
        +is_active / started_at / ends_at / cancelled_at
        --
        +tier: DRASubscriptionTier
    }

    class DRAPaymentTransaction {
        +id: number
        +organization_id: number
        +type: charge|refund|credit|adjustment
        +status: completed|failed|pending|reversed
        +amount: decimal (negative for refunds)
        +paddle_transaction_id (unique)
        +tier_name / billing_cycle / paddle_invoice_url
    }

    class DRAPaddleWebhookEvent {
        +event_id (unique)
        +event_type: string
        +payload: JSONB
        +processed: boolean
        +error_message / received_at / processed_at
    }

    class DRAPromoCode {
        +code (unique)
        +discount_type: percentage|fixed_amount|free_trial|upgraded_tier
        +discount_value / discount_duration_months
        +valid_from / valid_until / is_active
        +max_uses / max_uses_per_user / current_uses
        +applicable_tiers / applicable_users / email_domain_restriction
        +paddle_discount_id
    }

    class DRAAccountCancellation {
        +users_platform_id: number
        +status: pending|active|data_deleted|reactivated
        +effective_at / deletion_scheduled_at
        +reason: string
    }
}

' ------------------------------------------------------------------
' Growth / content
package "Growth & Content" {
    class DRAArticle {
        +id: number
        +title: string
        +content: string (HTML)
        +content_markdown: string
        +slug: string (unique)
        +status: EPublishStatus (PUBLISHED|DRAFT)
        --
        +categories: DRACategory[]
        +versions: DRAArticleVersion[]
    }

    class DRACategory {
        +id: number
        +name: string
        --
        +articles: DRAArticle[]
    }

    class DRALeadGenerator {
        +id: number
        +slug: string
        +file_path: string
        +downloads_count: number
        --
        +leads: DRALeadGeneratorLead[]
    }

    class DRAEmailFunnel {
        +id: number
        +slug / trigger_type / target_user_type
        --
        +steps: DRAEmailFunnelStep[]
        +enrollments: DRAEmailFunnelEnrollment[]
    }

    class DRANotification {
        +id: number
        +users_platform_id: number
        +type: string
        +title / message / link
        +is_read: boolean
        +expires_at: Date
    }
}

' ------------------------------------------------------------------
' Relationships
DRAUsersPlatform ||--o{ DRAOrganizationMember : "belongs to"
DRAUsersPlatform ||--o{ DRAProjectMember : "member of"
DRAOrganization ||--o{ DRAOrganizationMember : "has"
DRAOrganization ||--o{ DRAWorkspace : "contains"
DRAWorkspace ||--o{ DRAWorkspaceMember : "has"
DRAOrganization ||--o{ DRASSOConfiguration : "configures"
DRAOrganization ||--o| DRAOrganizationSubscription : "owns (1:1)"

DRAOrganization ||--o{ DRAProject : "contains"
DRAWorkspace ||--o{ DRAProject : "contains"
DRAProject ||--o{ DRAProjectMember : "has"
DRAProject ||--o{ DRADataSource : "contains"
DRAProject ||--o{ DRADashboard : "includes"
DRAProject ||--o{ DRACampaign : "tracks"
DRAProject ||--o{ DRAReport : "produces"
DRAProject ||--o{ DRAAIInsightReport : "generates"
DRAProject ||--o{ DRAPaidMediaPlan : "builds plans"

DRADataSource ||--o{ DRADataModel : "materializes"
DRADataSource ||--o{ DRATableMetadata : "describes"
DRADataSource ||--o{ DRAMongoDBSyncHistory : "syncs"
DRADataModel ||--o{ DRADataModelRefreshHistory : "tracks refreshes"
DRADataModel ||--o{ DRADataModelLineage : "parent/child edges"
DRADataModel }o--o{ DRADataModelSource : "cross-source junction"

DRAOrganizationSubscription }o--|| DRASubscriptionTier : "resolves"
DRAOrganizationSubscription ||--o{ DRAPaymentTransaction : "ledger"
DRAOrganizationSubscription ||--o{ DRAPaddleWebhookEvent : "audit"

DRAPaidMediaPlan ||--o{ DRAPaidMediaPlanStep : "executes"
DRAPaidMediaPlan ||--o{ DRAPaidMediaPlanArtifact : "produces"
DRAPaidMediaPlan ||--o{ DRAPaidMediaPlanMessage : "chats"
DRAPaidMediaPlan ||--o{ DRACampaign : "launches"
DRACampaign ||--o{ DRACampaignChannel : "has"

DRAReport ||--o{ DRAReportItem : "contains"
DRAReport ||--o| DRAReportShareKey : "public share (1:1)"
DRAArticle }o--o{ DRACategory : "categorized by"
DRAArticle ||--o{ DRAArticleVersion : "versions"

note right of DRADataSource : connection_details encrypted\nvia TypeORM ValueTransformer\n(AES-256-GCM)
note right of DRADataModel : data_layer enum drives\nmedallion architecture\n(raw > clean > business-ready)
note right of DRASubscriptionTier : tier_rank is authoritative\n(0/10/20/30/40); limits with\n-1 mean unlimited
note right of DRAAICallLog : one row per Gemini call;\nper-feature cost tracking via\nfeature_key + action_id

@enduml
