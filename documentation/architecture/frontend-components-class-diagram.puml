@startuml Frontend_Components_Class_Diagram
!theme aws-orange
title Data Research Analysis Platform - Frontend Architecture (2026)

' Define styling
skinparam class {
    BackgroundColor LightBlue
    BorderColor DarkBlue
    ArrowColor DarkBlue
}
skinparam package {
    BackgroundColor LightGray
    BorderColor Gray
}

package "Nuxt App Shell" {
    class app.vue {
        +NuxtLayout + NuxtPage
        +Organization JSON-LD (SSR)
        +idle cache warming
    }
    class error.vue {
        +SSR-safe 404/500
        +recovery actions
    }
    class nuxt.config.ts {
        +ssr: true
        +lazy components
        +GTM + Consent Mode v2
        +runtimeConfig.public
        +routeRules (immutable cache)
    }
    class layouts {
        +default.vue
        +project.vue
    }
}

package "Global Middleware (8)" as Middleware {
    class "00-route-loader" as M0 {
        +batch loader spanning
        +parallel middleware calls
    }
    class "00a-redirectOldRoutes" as M0a {
        +deprecation redirects
    }
    class "00b-normalize-path" as M0b {
        +canonical URLs (trailing slash)
    }
    class "01-authorization" as M1 {
        +public allow-list
        +token validation (30s cache)
        +/admin gate
    }
    class "02-load-data" as M2 {
        +ROUTE_DATA_REQUIREMENTS map
        +parallel store loads
        +5-min localStorage TTL
    }
    class "03-validate-data" as M3 {
        +route param validation
        +selected item resolution
    }
    class "04-project-role" as M4 {
        +client RBAC: analyst > manager > cmo
    }
    class "05-advanced-tools" as M5 {
        +BI gating via useAdvancedTools
    }
}

package "Pinia Stores (23)" as Stores {
    class logged_in_user {
        +current user / token
    }
    class subscription {
        +tier / usage / entitlements
        +resetForOrganizationChange
    }
    class organizations {
        +orgs / workspaces / members
        +selected org state
    }
    class projects {
        +projects / selectedProject
        +myProjectRole
    }
    class paid_media_plans {
        +plan CRUD / gates / streaming
        +guest plan funnel
        +Socket.IO listeners
    }
    class data_sources {
        +data sources + OAuth/sync
        +syncStatus maps
    }
    class data_models {
        +models / metadata / refresh
        +paginated data cache
    }
    class dashboards {
        +dashboards / public shares
    }
    class campaigns {
        +campaigns / channels / linking
    }
    class ai-data-modeler {
        +AI model chat drawer
    }
    class insights {
        +AI insights sessions
    }
    class notifications {
        +notification feed
    }
    class articles {
        +admin/public articles
    }
    class promo_codes {
        +promo admin
    }
    class scheduled_backups {
        +backup jobs
    }
    class sitemap {
        +sitemap entries
    }
    class user_management {
        +admin users
    }
    class intelligenceHub {
        +hub summary / top campaigns
    }
    class funnel {
        +funnel stage builder
    }
    class email_preferences {
        +notification prefs
    }
    class enterprise_queries {
        +enterprise inquiry list
    }
    class "admin/subscription-tiers" as AdminTiers {
        +tier admin CRUD
    }
}

package "Composables (91, grouped)" as Composables {
    class useAppFetch {
        +batch-loader-aware $fetch
    }
    class useAuthenticatedFetch {
        +client-only useAsyncData
        +bearer + org headers
    }
    class useTierLimits {
        +pre-create limit checks
        +upgradeTiers
    }
    class useProjectRole {
        +analyst/manager/cmo
    }
    class useAdvancedTools {
        +plan entitlement x org setting
    }
    class useOrganizationContext {
        +X-Organization-Id / X-Workspace-Id
    }
    class useMarkdown {
        +marked -> DOMPurify allow-list
    }
    class usePaddle {
        +checkout / portal / activation
    }
    class useGlobalLoader {
        +SweetAlert batch loader
    }
    class useCacheManager {
        +localStorage TTL cache
    }
    class useSSRPerformance {
        +TTFB/FCP/LCP/TBT budgets
    }
    class useGoogleOAuth {
        +Google auth flow
    }
    class useMetaAds {
        +Meta / Google / GAM connector flows
    }
    class useCampaignAnalysis {
        +KPI / trend / dimensions
    }
    class useAnomalyAlerts {
        +alert detection
    }
    class useReportBuilder {
        +report building
    }
    class useDataModelChat {
        +model chat
    }
    class useLogout {
        +teardown all 23 stores
    }
    class useGtm {
        +dataLayer + consent
    }
    class useGeolocation {
        +EU/US/RoW consent region
    }
}

package "Plugins (18)" as Plugins {
    class api-loader {
        +no-op (moved to useAppFetch)
    }
    class init-user {
        +background /auth/me
    }
    class socketio {
        +lazy Socket.IO client
        +sync/model-refresh listeners
    }
    class paddle {
        +Paddle v2 SDK
    }
    class ga-consent {
        +Consent Mode v2 restore (LAST)
    }
    class recaptcha {
        +vue-recaptcha-v3
    }
    class fontawesome {
        +curated icon subset
    }
    class htmlToImage {
        +code-split exporter
    }
    class draggable {
        +vuedraggable code-split
    }
    class sweetalert2 {
        +lazy $swal
    }
    class vuetippy {
        +client + server stub
    }
    class prefetch-links {
        +hover route prefetch
    }
    class navigation-perf {
        +router timing instrumentation
    }
}

package "Pages (129)" as Pages {
    class "marketing (15)" as P1 {
        +index / pricing / problem pages
    }
    class "auth (9)" as P2 {
        +login / register / oauth / sso
    }
    class "projects app (43)" as P3 {
        +channels / data-models
        +dashboards / reports / insights
        +intelligence / campaigns / plans
    }
    class "admin (40)" as P4 {
        +users / orgs / articles
        +email-funnels / promo-codes
        +ai-usage / database / tiers
    }
    class "public (4)" as P5 {
        +public-dashboard / public-report
        +unsubscribe
    }
    class "guest plan (1)" as P6 {
        +guest/plan/[token]
    }
}

' Dependencies
app.vue --> Pages
Middleware --> Stores : "load / validate / guard"
Stores --> Composables : "use for requests"
Composables --> "REST API (backend)" : "useAppFetch / useAuthenticatedFetch"
socketio --> "Socket.IO (backend)" : "real-time"
Pages --> "Components (218 lazy)"
app.vue --> Plugins

note right of Stores : setup-style Pinia; refs + set*/get*\nlocalStorage sync + retrieve* API actions\nmodule-level initialized guard
note right of Composables : grouped: HTTP/auth, access, data,\ncharts/reports, connectors, intelligence,\nbilling, perf/UX
note right of Pages : SSR for marketing;\nclient-only data for protected app

@enduml
