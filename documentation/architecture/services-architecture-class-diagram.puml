@startuml Services_Architecture_Class_Diagram
!theme aws-orange
title Data Research Analysis Platform - Services Architecture (2026)

' Define styling
skinparam class {
    BackgroundColor LightBlue
    BorderColor DarkBlue
    ArrowColor DarkBlue
}
skinparam package {
    BackgroundColor LightGray
    BorderColor Gray
}

package "HTTP Layer" {
    class "routes/* (81 files)" as Routes {
        +54 root route files
        +27 admin route files
        --
        Express Routers mounted in index.ts
    }

    class "controllers/* (6)" as Controllers {
        +AIDataModelerController (2466 ln)
        +InsightsController
        +CampaignController
        +FunnelController
        +MarketingMetricsController
        +CampaignTargetsController
        --
        Thin static-method HTTP adapters
    }

    class "middleware/* (13)" as Middleware {
        +validateJWT (authenticate)
        +authorize / rbacMiddleware
        +organizationContext / workspaceContext
        +requiresProjectRole
        +tierEnforcement (9 guards)
        +requiresProductionAccess
        +rateLimit (9 limiters)
        +validator / validation
        +etagCache / validateFileUpload
    }
}

